# Keep this file minimal: zsh reads .zshenv for every shell (interactive and non-interactive).
# Primary config lives in $XDG_CONFIG_HOME/zsh.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export ZDOTDIR="${ZDOTDIR:-$XDG_CONFIG_HOME/zsh}"

# Delegate to the real .zshenv, but avoid self-sourcing loops when ZDOTDIR points to $HOME.
if [[ "$ZDOTDIR" != "$HOME" && -f "$ZDOTDIR/.zshenv" ]]; then
	source "$ZDOTDIR/.zshenv"
fi
