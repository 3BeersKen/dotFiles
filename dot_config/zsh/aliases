# --- eza - a modern replacement for ls ---
alias la='eza --all --color=always --group-directories-first --icons'
alias ll='eza --color=always --group-directories-first --icons --long --octal-permissions'
alias lla='eza --all --color=always --group-directories-first --icons --long --octal-permissions'
alias ls='eza --color=always --group-directories-first --icons'
alias lt='eza --color=always --group-directories-first --icons --level=2 --tree'
