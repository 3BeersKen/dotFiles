# Zim module definitions.
# This file is read by the zimfw tool, not sourced directly during shell startup.
# Keep module order intentional: completion should load before syntax highlighting.

# Use git for module management.
zstyle ':zim:zmodule' use 'git'

# Core shell behavior.
zmodule environment
zmodule git
zmodule input
zmodule termtitle
zmodule utility

# Completion modules.
zmodule zsh-users/zsh-completions --fpath src
zmodule completion

# Interactive enhancements.
zmodule zsh-users/zsh-autosuggestions
zmodule zsh-users/zsh-history-substring-search
zmodule zsh-users/zsh-syntax-highlighting

# Prompt theme.
zmodule bira
